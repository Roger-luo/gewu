{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gewu",
  "version": "0.1.0",
  "identifier": "dev.gewu.desktop",
  "build": {
    "frontendDist": "../../apps/desktop/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": {
      "script": "pnpm dev",
      "cwd": "../../apps/desktop"
    },
    "beforeBuildCommand": {
      "script": "pnpm build",
      "cwd": "../../apps/desktop"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Gewu",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/henry.w@example.net",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
