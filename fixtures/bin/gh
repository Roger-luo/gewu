#!/usr/bin/env python3
"""A stand-in for the GitHub CLI, for journeys and tests.

Answers `gh pr list` and `gh pr view` from the JSON file named by
`GEWU_FAKE_GH`, keyed by the repository's directory name:

    {"shop": [{"number": 7, "title": "...", "author": {"login": "ada"},
               "headRefName": "feature/x", "baseRefName": "main",
               "body": "optional description"}]}

Any other repository, or any other command, fails as `gh` does when a
repository has no GitHub remote.
"""

import json
import os
import subprocess
import sys


def pulls():
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if top.returncode != 0:
        return None
    path = os.environ.get("GEWU_FAKE_GH")
    if not path:
        return None
    with open(path, encoding="utf-8") as handle:
        return json.load(handle).get(os.path.basename(top.stdout.strip()))


def main(args):
    known = pulls()
    if known is None or args[:1] != ["pr"]:
        print("no git remotes found", file=sys.stderr)
        return 1
    if args[1:2] == ["list"]:
        print(json.dumps(known))
        return 0
    if args[1:2] == ["view"] and len(args) > 2:
        for pull in known:
            if str(pull["number"]) == args[2]:
                print(json.dumps({
                    "baseRefName": pull["baseRefName"],
                    "title": pull["title"],
                    "body": pull.get("body", ""),
                }))
                return 0
        print(f"no pull requests found for {args[2]}", file=sys.stderr)
        return 1
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
